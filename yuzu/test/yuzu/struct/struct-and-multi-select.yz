// RUN: %yuzu-compile --debug-hir %s 2>&1 | %FileCheck %s --implicit-check-not=error:
//
// A struct declares a named row type; a multi-column `select` projects several
// fields, each typed via field access against the row alias.
struct Point { x: int32, y: int32 }
table points = Point
let r = from points p |> select p.x as a, p.y as b
// CHECK: StructStmt : struct
// CHECK:   name=Point
// CHECK: SelectExpr : relation
// CHECK: FieldAccessExpr : int32
// CHECK: FieldAccessExpr : int32
