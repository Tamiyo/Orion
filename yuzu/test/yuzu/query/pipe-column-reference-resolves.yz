// RUN: %yuzu-compile --debug-hir %s 2>&1 | %FileCheck %s --implicit-check-not=error:
//
// A `select` output column is referenceable by name in the next stage: the
// aliased column `c` resolves in the second `select` and types as its column
// type (`int32`).
struct Employee { id: str, tenure: int32 }
table employees = Employee
let r = from employees e |> select e.tenure as c |> select c
// The whole query still types as a relation (it would error if `c` did not
// resolve), and the second stage's `c` reference types as its column.
// CHECK: SelectRel : relation
// CHECK: IdentExpr : int32
// CHECK-NEXT: Ident
// CHECK-NEXT: name=c
