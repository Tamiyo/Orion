// RUN: %yuzu-compile --debug-hir %s 2>&1 | %FileCheck %s --implicit-check-not=error:
//
// A table may declare its row schema inline instead of naming a struct.
table events = { user_id: int32, ts: int64 }
let r = from events e |> select e.user_id as u
// CHECK: TableStmt : relation
// CHECK: FieldAccessExpr : int32
