// RUN: %yuzu-compile %s 2>&1 | %FileCheck %s
//
// Each pipe stage sees only its immediate input's columns. After `select e.id`
// projects the row down to just `id`, the original `from` alias `e` is out of
// scope, so the next stage's `e.tenure` does not resolve.
struct Employee { id: str, tenure: int32 }
table employees = Employee
let r = from employees e |> select e.id |> select e.tenure
// CHECK: error: unresolved identifier
