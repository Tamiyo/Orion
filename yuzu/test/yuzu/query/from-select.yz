// RUN: %yuzu-compile --debug-hir %s 2>&1 | %FileCheck %s --implicit-check-not=error:
//
// A pipe query is an expression of type `Relation[T]`. `from` resolves the
// table and binds the row alias `e : Employee`; the `select` item types via
// field access (`e.id : int32`); the whole query types as a relation.
struct Employee { id: int32, name: str }
table employees = Employee
let r = from employees e |> select e.id as x
// CHECK:      LetStmt : relation
// CHECK:        SelectRel : relation
// CHECK-NEXT:     FromRel : relation
// CHECK:            name=employees
// `e` is the row alias, bound to the `Employee` struct row type.
// CHECK:          Ident : struct
// CHECK-NEXT:        name=e
// CHECK:          SelectItem
// The projected expression `e.id`: base `e` (an IdentExpr), then field `.id`.
// CHECK-NEXT:       FieldAccessExpr : int32
// CHECK-NEXT:         IdentExpr : struct
// CHECK-NEXT:           Ident
// CHECK-NEXT:             name=e
// CHECK-NEXT:         Ident
// CHECK-NEXT:           name=id
// The `as x` output column name — a sibling of the FieldAccessExpr, not part
// of `e.id`.
// CHECK-NEXT:       Ident
// CHECK-NEXT:         name=x
