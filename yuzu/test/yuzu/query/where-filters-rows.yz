// RUN: %yuzu-compile --debug-hir %s 2>&1 | %FileCheck %s --implicit-check-not=error:
//
// A `|> where` stage filters the input's rows by a boolean predicate and keeps
// the input's row type (the whole query still types as a relation). The
// predicate is typed against the preceding stage's columns and must be `bool`.
struct Employee { id: str, tenure: int32 }
table employees = Employee
let r = from employees e |> select e.tenure as t |> where t > 10
// CHECK: WhereRel : relation
// CHECK: SelectRel : relation
