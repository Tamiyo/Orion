{
  "name": "yuzu",
  "displayName": "Yuzu",
  "description": "Syntax highlighting for the Yuzu language",
  "version": "0.1.0",
  "publisher": "yuzu",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "yuzu",
        "aliases": [
          "Yuzu",
          "yuzu"
        ],
        "extensions": [
          ".yz"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yuzu",
        "scopeName": "source.yuzu",
        "path": "./syntaxes/yuzu.tmLanguage.json"
      }
    ]
  }
}
