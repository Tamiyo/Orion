{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "information_for_contributors": [
    "Generated by `yuzu-tblgen -gen-textmate-grammar` from TokenKind.td.",
    "Run `make grammar` to regenerate; do not edit by hand."
  ],
  "name": "Yuzu",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.yuzu"
        }
      ]
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "name": "entity.name.function.call.yuzu"
    },
    "function-declaration": {
      "captures": {
        "1": {
          "name": "keyword.declaration.function.yuzu"
        },
        "2": {
          "name": "entity.name.function.yuzu"
        }
      },
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)"
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(and|fn|in|let|mut|not|or|return|where)\\b",
          "name": "keyword.control.yuzu"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.yuzu"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "0[xX][0-9a-fA-F][0-9a-fA-F_]*",
          "name": "constant.numeric.hex.yuzu"
        },
        {
          "match": "0[bB][01][01_]*",
          "name": "constant.numeric.binary.yuzu"
        },
        {
          "match": "([0-9][0-9_]*\\.[0-9_]*|\\.[0-9][0-9_]*)([eE][+-]?[0-9][0-9_]*)?|[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*",
          "name": "constant.numeric.float.yuzu"
        },
        {
          "match": "[0-9][0-9_]*",
          "name": "constant.numeric.integer.yuzu"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(->|==|>=|<=|!=|\\*\\*|<<|>>|=|>|<|-|\\+|\\/|\\*)",
          "name": "keyword.operator.yuzu"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "match": "r\"[^\"]*\"",
          "name": "string.quoted.double.raw.yuzu"
        },
        {
          "match": "\"([^\"\\\\]|\\\\.)*\"",
          "name": "string.quoted.double.yuzu"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
              "name": "entity.name.type.yuzu"
            }
          ]
        },
        {
          "match": "(?<=:)\\s*[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.name.type.yuzu"
        },
        {
          "match": "(?<=->)\\s*[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.name.type.yuzu"
        }
      ]
    }
  },
  "scopeName": "source.yuzu"
}
