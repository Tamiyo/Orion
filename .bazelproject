# Bazel project configuration for yuzu

workspace_type: c

directories:
  .
  -bazel-bin
  -bazel-out
  -bazel-testlogs
  -bazel-yuzu

targets:
  //src/...
  //test/...

build_flags:
  --repo_env=CC=clang
  --repo_env=CXX=clang++
  --cxxopt=-std=c++17
  --copt=-Wall
  --copt=-Wextra
  --copt=-Werror
  --copt=-fcolor-diagnostics

test_flags:
  --test_output=errors
  --test_summary=detailed

# Additional source directories for IDE indexing
additional_languages:
  c

derive_targets_from_directories: true

# Import other project settings if needed
# import_run_configurations: scripts/bazel_run_configs.xml
